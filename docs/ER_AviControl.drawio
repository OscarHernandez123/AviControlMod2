<mxfile host="app.diagrams.net">
  <diagram id="iyJilnyGqXuefWWFoijD" name="Página-1">
    <mxGraphModel dx="8583" dy="4725" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;\nerDiagram\n\n  %% Referencias externas del Módulo 1.\n\n  GALPON {\n    uuid id PK\n    varchar nombre\n    int aforo_maximo\n    varchar estado\n  }\n\n  LOTE {\n    uuid id PK\n    varchar nombre\n    int poblacion_inicial\n    int poblacion_actual\n    date fecha_ingreso\n    decimal costo_total\n    uuid galpon_id FK\n  }\n\n  %% El tipo clasifica alimentos. Los demás dominios usan ALIMENTO.\n  %% La ración se almacena en gramos por ave por día.\n\n  TIPO_ALIMENTO {\n    uuid id PK\n    varchar nombre\n    enum etapa_crianza\n  }\n\n  ALIMENTO {\n    uuid id PK\n    uuid tipo_alimento_id FK\n    varchar nombre_comercial\n    varchar marca\n    decimal peso_bulto_kg\n    varchar estado\n  }\n\n  MEDICAMENTO {\n    uuid id PK\n    varchar nombre\n    varchar principio_activo\n    varchar unidad_base\n    varchar estado\n  }\n\n  %% Planes nutricionales\n\n  PLAN_NUTRICIONAL {\n    uuid id PK\n    varchar nombre\n    varchar tipo_ave\n    boolean es_predeterminado\n    boolean activo\n  }\n\n  ETAPA_PLAN {\n    uuid id PK\n    uuid plan_nutricional_id FK\n    enum etapa_crianza\n    int dia_inicio\n    int dia_fin\n    decimal racion_gr_ave_dia\n    uuid alimento_id FK\n  }\n\n  PLAN_GALPON {\n    uuid id PK\n    uuid plan_nutricional_id FK\n    uuid lote_id FK\n    varchar estado\n    date fecha_asignacion\n  }\n\n  %% Copia operativa de las etapas: cambios a la plantilla no alteran\n  %% el plan asignado a un lote.\n\n  ETAPA_GALPON {\n    uuid id PK\n    uuid plan_galpon_id FK\n    enum etapa_crianza\n    int dia_inicio\n    int dia_fin\n    int dias_prorroga\n    decimal racion_gr_ave_dia\n    uuid alimento_id FK\n    varchar estado\n  }\n\n  HISTORIAL_AJUSTE_ETAPA {\n    uuid id PK\n    uuid etapa_galpon_id FK\n    timestamp fecha_ajuste\n    varchar motivo\n    varchar justificacion\n    int dias_previos\n    int dias_nuevos\n  }\n\n  PROYECCION_ALIMENTO_ETAPA {\n    uuid id PK\n    uuid etapa_galpon_id FK\n    decimal poblacion_referencia\n    int dias_proyectados\n    decimal proyeccion_kg\n    decimal costo_unitario_kg\n    timestamp capturada_en\n  }\n\n  HISTORIAL_AJUSTE_PROYECCION {\n    uuid id PK\n    uuid proyeccion_id FK\n    timestamp fecha_ajuste\n    varchar motivo\n    varchar justificacion\n    decimal proyeccion_anterior_kg\n    decimal proyeccion_nueva_kg\n  }\n\n  %% Bodega y recepciones.\n\n  BODEGA_CENTRAL {\n    uuid id PK\n    varchar nombre\n    decimal capacidad\n    varchar unidad_capacidad\n  }\n\n  RECEPCION_ALIMENTO {\n    uuid id PK\n    uuid bodega_id FK\n    uuid alimento_id FK\n    varchar codigo_lote\n    varchar alimento_nombre_snapshot\n    varchar tipo_alimento_snapshot\n    date fecha_ingreso\n    date fecha_vencimiento\n    decimal cantidad_bultos\n    decimal peso_bulto_kg\n    decimal precio_neto_bulto\n    decimal porcentaje_impuesto\n    varchar estado\n    timestamp registrada_en\n  }\n\n  RECEPCION_MEDICAMENTO {\n    uuid id PK\n    uuid bodega_id FK\n    uuid medicamento_id FK\n    varchar codigo_lote\n    varchar presentacion\n    decimal cantidad_presentaciones\n    decimal contenido_por_presentacion\n    varchar unidad_medida\n    decimal precio_neto_presentacion\n    date fecha_ingreso\n    date fecha_vencimiento\n    varchar estado\n    timestamp registrada_en\n  }\n\n  %% Los movimientos se vinculan a la recepción afectada para conservar\n  %% la trazabilidad FEFO. bodega_id se obtiene desde la recepción.\n\n  MOVIMIENTO_ALIMENTO {\n    uuid id PK\n    uuid recepcion_alimento_id FK\n    uuid suministro_id FK\n    varchar tipo\n    varchar estado\n    decimal cantidad_kg\n    timestamp ocurrido_en\n    varchar motivo\n  }\n\n  MOVIMIENTO_MEDICAMENTO {\n    uuid id PK\n    uuid recepcion_medicamento_id FK\n    varchar tipo\n    varchar estado\n    decimal cantidad_unidad_base\n    timestamp ocurrido_en\n    varchar motivo\n  }\n\n  AUDITORIA_RECEPCION_ALIMENTO {\n    uuid id PK\n    uuid recepcion_alimento_id FK\n    varchar accion\n    timestamp ocurrida_en\n    json valores_anteriores\n    json valores_nuevos\n  }\n\n  AUDITORIA_RECEPCION_MEDICAMENTO {\n    uuid id PK\n    uuid recepcion_medicamento_id FK\n    varchar accion\n    timestamp ocurrida_en\n    json valores_anteriores\n    json valores_nuevos\n  }\n\n  %% Un suministro confirmado puede originar varios movimientos de salida\n  %% al descontar de distintas recepciones mediante FEFO.\n\n  SUMINISTRO_ALIMENTO {\n    uuid id PK\n    uuid lote_id FK\n    uuid alimento_id FK\n    date fecha\n    decimal cantidad_kg\n    timestamp registrado_en\n    varchar observaciones\n  }\n\n  %% Enfermedades, medicaciones y diagnósticos.\n  %% El diagnóstico referencia directamente la enfermedad; la medicación es opcional.\n\n  SOLICITUD_REVISION_AISLAMIENTO {\n    uuid id PK\n    uuid galpon_id FK\n    timestamp solicitada_en\n    varchar motivo\n    varchar signos_clinicos\n    varchar estado\n    timestamp revisada_en\n    varchar decision\n  }\n\n  ENFERMEDAD {\n    uuid id PK\n    varchar nombre\n    varchar nivel_riesgo\n    varchar tipo\n    varchar descripcion_clinica\n    boolean requiere_sacrificio_sanitario\n    boolean activa\n  }\n\n  MEDICACION {\n    uuid id PK\n    uuid enfermedad_id FK\n    uuid medicamento_id FK\n    varchar dosis\n    int dias_totales\n    varchar via_administracion\n    varchar descripcion\n    boolean activa\n  }\n\n  DIAGNOSTICO_GALPON {\n    uuid id PK\n    uuid solicitud_revision_id FK\n    uuid lote_id FK\n    uuid enfermedad_id FK\n    uuid medicacion_id FK\n    varchar enfermedad_nombre_snapshot\n    varchar medicacion_dosis_snapshot\n    date diagnosticado_en\n    date fecha_reintegro\n    varchar estado\n  }\n\n  %% Consumos y detalle por recepción de inventario.\n\n  CONSUMO_MEDICAMENTO {\n    uuid id PK\n    uuid diagnostico_id FK\n    decimal cantidad_ingresada\n    varchar unidad_ingresada\n    decimal cantidad_normalizada\n    varchar unidad_base\n    date fecha_aplicacion\n    timestamp registrado_en\n  }\n\n  DETALLE_CONSUMO_MEDICAMENTO {\n    uuid id PK\n    uuid consumo_id FK\n    uuid recepcion_medicamento_id FK\n    decimal cantidad_descontada\n    decimal precio_neto_historico\n    varchar moneda\n  }\n\n  %% Mortalidad y alertas sanitarias.\n\n  REGISTRO_MORTALIDAD {\n    uuid id PK\n    uuid lote_id FK\n    varchar tipo\n    timestamp ocurrido_en\n    int cantidad_muertes\n    int poblacion_referencia\n    varchar causa\n    varchar causa_probable\n    varchar nivel_severidad\n    varchar observaciones\n  }\n\n  ALERTA_SANITARIA {\n    uuid id PK\n    uuid registro_mortalidad_id FK\n    varchar prioridad\n    varchar estado\n    timestamp emitida_en\n    timestamp atendida_en\n    varchar observaciones_atencion\n  }\n\n  %% Sacrificio programado y sanitario.\n\n  ORDEN_SACRIFICIO {\n    uuid id PK\n    uuid lote_id FK\n    timestamp programada_para\n    varchar estado\n    timestamp creada_en\n    timestamp ejecutada_en\n    varchar motivo_cancelacion\n  }\n\n  RESULTADO_SACRIFICIO {\n    uuid id PK\n    uuid orden_sacrificio_id FK\n    int cantidad_final_pollos\n    decimal peso_total_kg\n    timestamp registrado_en\n    timestamp corregido_en\n  }\n\n  ORDEN_SACRIFICIO_SANITARIO {\n    uuid id PK\n    uuid diagnostico_id FK\n    boolean alcance_total\n    int poblacion_a_sacrificar\n    varchar estado\n    timestamp emitida_en\n    timestamp ejecutada_en\n    varchar observaciones\n  }\n\n  %% Relaciones externas\n\n  GALPON ||--o{ LOTE : aloja\n\n  %% Catálogo y alimentación\n\n  TIPO_ALIMENTO ||--o{ ALIMENTO : clasifica\n  PLAN_NUTRICIONAL ||--|{ ETAPA_PLAN : define\n  ALIMENTO ||--o{ ETAPA_PLAN : se_asigna\n  PLAN_NUTRICIONAL ||--o{ PLAN_GALPON : se_asigna\n  LOTE ||--o{ PLAN_GALPON : recibe\n  PLAN_GALPON ||--|{ ETAPA_GALPON : contiene\n  ETAPA_GALPON ||--o{ HISTORIAL_AJUSTE_ETAPA : conserva\n  ETAPA_GALPON ||--o| PROYECCION_ALIMENTO_ETAPA : proyecta\n  PROYECCION_ALIMENTO_ETAPA ||--o{ HISTORIAL_AJUSTE_PROYECCION : conserva\n  ALIMENTO ||--o{ ETAPA_GALPON : se_asigna\n  LOTE ||--o{ SUMINISTRO_ALIMENTO : recibe\n  ALIMENTO ||--o{ SUMINISTRO_ALIMENTO : se_suministra\n\n  %% Inventario de alimento\n\n  BODEGA_CENTRAL ||--o{ RECEPCION_ALIMENTO : recibe\n  ALIMENTO ||--o{ RECEPCION_ALIMENTO : identifica\n  RECEPCION_ALIMENTO ||--o{ MOVIMIENTO_ALIMENTO : afecta\n  RECEPCION_ALIMENTO ||--o{ AUDITORIA_RECEPCION_ALIMENTO : audita\n  SUMINISTRO_ALIMENTO o|--o{ MOVIMIENTO_ALIMENTO : genera\n\n  %% Inventario de medicamento\n\n  BODEGA_CENTRAL ||--o{ RECEPCION_MEDICAMENTO : recibe\n  MEDICAMENTO ||--o{ RECEPCION_MEDICAMENTO : identifica\n  RECEPCION_MEDICAMENTO ||--o{ MOVIMIENTO_MEDICAMENTO : afecta\n  RECEPCION_MEDICAMENTO ||--o{ AUDITORIA_RECEPCION_MEDICAMENTO : audita\n\n  %% Sanidad y consumo de medicamentos\n\n  GALPON ||--o{ SOLICITUD_REVISION_AISLAMIENTO : recibe\n  SOLICITUD_REVISION_AISLAMIENTO ||--o| DIAGNOSTICO_GALPON : puede_originar\n  LOTE ||--o{ DIAGNOSTICO_GALPON : corresponde\n  ENFERMEDAD ||--o{ DIAGNOSTICO_GALPON : se_diagnostica\n  ENFERMEDAD ||--o{ MEDICACION : tiene_tratamientos\n  MEDICAMENTO ||--o{ MEDICACION : se_utiliza\n  MEDICACION o|--o{ DIAGNOSTICO_GALPON : puede_prescribirse\n  DIAGNOSTICO_GALPON ||--o{ CONSUMO_MEDICAMENTO : origina\n  CONSUMO_MEDICAMENTO ||--|{ DETALLE_CONSUMO_MEDICAMENTO : detalla\n  RECEPCION_MEDICAMENTO ||--o{ DETALLE_CONSUMO_MEDICAMENTO : descuenta\n\n  %% Mortalidad y alertas\n\n  LOTE ||--o{ REGISTRO_MORTALIDAD : presenta\n  REGISTRO_MORTALIDAD ||--o| ALERTA_SANITARIA : puede_generar\n\n  %% Sacrificios\n\n  LOTE ||--o{ ORDEN_SACRIFICIO : tiene\n  ORDEN_SACRIFICIO ||--o| RESULTADO_SACRIFICIO : produce\n  DIAGNOSTICO_GALPON ||--o| ORDEN_SACRIFICIO_SANITARIO : puede_sustentar\n```&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="6jE7i5yU5rfOpLkovooj-1">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
