    # API de demostracion: siempre dirigida a la base aislada.
    set $modulo2_demo http://backend-demo:8080;
    location ^~ /demo/api/integracion/modulo3/ {
        limit_except GET POST { deny all; }
        rewrite ^/demo(/.*)$ $1 break;
        proxy_pass $modulo2_demo$uri$is_args$args;
        add_header X-Avicontrol-Environment DEMO always;
        add_header Cache-Control no-store always;
        add_header X-Content-Type-Options nosniff always;
    }
    location ~ "^/demo/api/lotes/[0-9a-fA-F-]{36}/alimento-requerido$" {
        limit_except GET { deny all; }
        rewrite ^/demo(/.*)$ $1 break;
        proxy_pass $modulo2_demo$uri$is_args$args;
        add_header X-Avicontrol-Environment DEMO always;
        add_header Cache-Control no-store always;
        add_header X-Content-Type-Options nosniff always;
    }
    location ~ "^/demo/api/ordenes-sacrificio/[0-9a-fA-F-]{36}/resultados$" {
        limit_except GET { deny all; }
        rewrite ^/demo(/.*)$ $1 break;
        proxy_pass $modulo2_demo$uri$is_args$args;
        add_header X-Avicontrol-Environment DEMO always;
        add_header Cache-Control no-store always;
        add_header X-Content-Type-Options nosniff always;
    }
