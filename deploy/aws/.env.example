# Copiar a .env en esta misma carpeta. Reemplazar TODOS los marcadores.
APP_DOMAIN=modulo2.example.com
AVICONTROL_DB_PASSWORD=REEMPLAZAR_PASSWORD_BD
AVICONTROL_MODULO1_BASE_URL=https://modulo1.example.com
SPRING_KAFKA_BOOTSTRAP_SERVERS=broker.example.com:9093
SPRING_KAFKA_PROPERTIES_SECURITY_PROTOCOL=SASL_SSL
SPRING_KAFKA_PROPERTIES_SASL_MECHANISM=SCRAM-SHA-512
# Completar localmente si el equipo del Módulo 1 utiliza SASL/SCRAM.
# SPRING_KAFKA_PROPERTIES_SASL_JAAS_CONFIG='org.apache.kafka.common.security.scram.ScramLoginModule required username="USUARIO" password="SECRETO";'
AVICONTROL_ADMIN_USERNAME=admin
AVICONTROL_ADMIN_PASSWORD=REEMPLAZAR_PASSWORD_ADMIN
AVICONTROL_VETERINARIO_USERNAME=veterinario
AVICONTROL_VETERINARIO_PASSWORD=REEMPLAZAR_PASSWORD_VET
AVICONTROL_TRABAJADOR_USERNAME=trabajador
AVICONTROL_TRABAJADOR_PASSWORD=REEMPLAZAR_PASSWORD_TRABAJADOR
AVICONTROL_NUTRICIONISTA_USERNAME=nutricionista
AVICONTROL_NUTRICIONISTA_PASSWORD=REEMPLAZAR_PASSWORD_NUTRICIONISTA
AVICONTROL_BODEGA_CAPACIDAD_KG=0
AVICONTROL_BODEGA_OCUPACION_KG=-1
# Ajustar inventario antes de utilizar sus formularios.
